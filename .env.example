# Every value here is optional. With all of them blank, Saath runs fully on the phone and never sends anything.
# Copy this file to .env.local to switch something on.

# Hosting in a sub-folder (for example GitHub Pages at /saath).
NEXT_PUBLIC_BASE_PATH=

# The public address of the app. Used by /link when it makes a school link and QR code.
# Leave empty to use whatever address the page is opened at.
NEXT_PUBLIC_SAATH_URL=

# Where anonymous cohort numbers go, if a student switches sharing on. See "Measuring impact" in the README.
# The same address must answer GET with the list of events, for the partner view at /impact.
# Leave empty and nothing is ever sent or collected.
NEXT_PUBLIC_SAATH_IMPACT_URL=

# The free Cloudflare Worker endpoint for confirmed feedback delivery and anonymous live-user measurement.
NEXT_PUBLIC_SAATH_SERVICE_URL=
