# Every value here is optional. With all of them blank, Saath runs fully on the phone with no account.
# Copy this file to .env.local to switch a feature on.

# --- Sign-in and sync (Supabase free tier) ---
# Project Settings > API in the Supabase dashboard. The anon key is safe to ship: row level security
# lets each user reach only their own row, and that row is encrypted on the phone first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Hosting in a sub-folder (for example GitHub Pages at /saath) ---
NEXT_PUBLIC_BASE_PATH=

# --- Optional AI reading layer (needs a server, so not GitHub Pages) ---
# Public flag. Set to 1 so the app may call /api/extract. Leave empty otherwise.
NEXT_PUBLIC_SAATH_AI=
# Free Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional swap. If GROQ_API_KEY is set, Groq is used instead of Gemini.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
